{
  "name": "ai-companion",
  "version": "1.0.0",
  "description": "Windows Electron Desktop Companion for real-time coding suggestions powered by Groq Vision AI",
  "main": "dist/main/main.js",
  "author": "AI Companion Team",
  "license": "MIT",
  "scripts": {
    "build:helper": "C:\\Windows\\Microsoft.NET\\Framework64\\v4.0.30319\\csc.exe /nologo /target:exe /out:resources\\active_window.exe resources\\ActiveWindow.cs",
    "typecheck": "tsc --noEmit",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "npm run build:helper && npm run build:main && npm run build:renderer",
    "start": "npm run build && electron .",
    "dev:main": "tsc -p tsconfig.main.json -w",
    "dev:renderer": "vite",
    "dev": "npm run build && electron .",
    "package:win": "npm run build && electron-builder --win --x64"
  },
  "build": {
    "appId": "com.aicompanion.desktop",
    "productName": "AI Companion",
    "win": {
      "target": "nsis"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "resources/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/",
        "to": "resources/"
      }
    ]
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "electron": "^35.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.8.2",
    "vite": "^6.2.0"
  }
}